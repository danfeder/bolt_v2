ault":[]},"avoidSlots":{"items":{"$ref":"#/components/schemas/TimeSlot"},"type":"array","title":"Avoidslots","default":[]}},"type":"object","required":["date","periods"],"title":"InstructorAvailability","example":{"avoidSlots":[],"date":"2025-02-12T00:00:00","periods":[1,2,3],"preferredSlots":[],"unavailableSlots":[]}},"ScheduleComparisonResult":{"properties":{"metric_name":{"type":"string","title":"Metric Name"},"baseline_value":{"type":"number","title":"Baseline Value"},"comparison_value":{"type":"number","title":"Comparison Value"},"difference":{"type":"number","title":"Difference"},"percentage_change":{"type":"number","title":"Percentage Change"},"improvement":{"type":"boolean","title":"Improvement"}},"type":"object","required":["metric_name","baseline_value","comparison_value","difference","percentage_change","improvement"],"title":"ScheduleComparisonResult","description":"Comparison between two schedules.","example":{"baseline_value":82.3,"comparison_value":85.5,"difference":3.2,"improvement":true,"metric_name":"Distribution Score","percentage_change":3.89}},"ScheduleConstraints":{"properties":{"maxClassesPerDay":{"type":"integer","title":"Maxclassesperday"},"maxClassesPerWeek":{"type":"integer","title":"Maxclassesperweek"},"minPeriodsPerWeek":{"type":"integer","title":"Minperiodsperweek"},"maxConsecutiveClasses":{"type":"integer","title":"Maxconsecutiveclasses"},"consecutiveClassesRule":{"type":"string","title":"Consecutiveclassesrule"},"startDate":{"type":"string","title":"Startdate"},"endDate":{"type":"string","title":"Enddate"},"allowConsecutiveClasses":{"type":"boolean","title":"Allowconsecutiveclasses","description":"If true, allows pairs of consecutive classes; if false, no consecutive classes allowed","default":true},"requiredBreakPeriods":{"items":{"type":"integer"},"type":"array","title":"Requiredbreakperiods","description":"List of periods that should be kept free (e.g., lunch periods)"}},"type":"object","required":["maxClassesPerDay","maxClassesPer
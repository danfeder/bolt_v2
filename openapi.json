{"openapi":"3.1.0","info":{"title":"Class Scheduler API","description":"\nScheduler API with configurable solver settings.\n\nRequired periods are treated as hard constraints and will always be respected.\nOther scheduling preferences can be configured through the solver settings.\n","version":"2.0.0"},"paths":{"/api/v1/scheduler/schedule/stable":{"post":{"tags":["Schedule Generation"],"summary":"Generate schedule using stable solver","description":"Generate a schedule using the stable solver configuration.\n    \n    This endpoint uses the CP-SAT solver which provides reliable and consistent\n    results. It handles all constraints properly but may be slower for\n    complex schedules.\n    \n    The stable solver is recommended for production use.","operationId":"create_schedule_stable_api_v1_scheduler_schedule_stable_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ScheduleRequest"}}},"required":true},"responses":{"200":{"description":"Successful schedule generation","content":{"application/json":{"schema":{"type":"object","title":"Response Create Schedule Stable Api V1 Scheduler Schedule Stable Post"},"example":{"status":"success","message":"Schedule generated successfully","data":{"assignments":[{"name":"PK207","classId":"class-123","date":"2025-02-12T00:00:00Z","timeSlot":{"dayOfWeek":1,"period":1}}],"metadata":{"duration_ms":1000,"solutions_found":1,"score":-857960000,"gap":-1.13,"solver":"cp-sat-stable"}}}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Internal server error"},"400":{"description":"Bad request","content":{"application/json":{"example":{"status":"error","message":"No solution found","errors":[{"message":"Schedule constraints are too restrictive"}]}}}}}}},"/api/v1/scheduler/schedule/dev":{"post":{"tags":["Schedule Generation"],"summary":"Generate schedule using genetic algorithm","description":"Generate a schedule using the development solver configuration.\n    \n    This endpoint uses the genetic algorithm for schedule generation,\n    which may provide better results in some cases but is still experimental.\n    The genetic algorithm is particularly good at optimizing for balanced\n    distribution and handling complex preferences.\n    \n    Note: This solver may take longer to run but can find solutions when\n    the stable solver fails due to tight constraints.","operationId":"create_schedule_dev_api_v1_scheduler_schedule_dev_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ScheduleRequest"}}},"required":true},"responses":{"200":{"description":"Successful schedule generation","content":{"application/json":{"schema":{"type":"object","title":"Response Create Schedule Dev Api V1 Scheduler Schedule Dev Post"},"example":{"status":"success","message":"Schedule generated successfully","data":{"assignments":[{"name":"PK207","classId":"class-123","date":"2025-02-12T00:00:00Z","timeSlot":{"dayOfWeek":1,"period":1}}],"metadata":{"duration_ms":3500,"solutions_found":1,"score":-750000000,"gap":-2.05,"solver":"genetic-algorithm"}}}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Internal server error"},"400":{"description":"Bad request","content":{"application/json":{"example":{"status":"error","message":"No valid solution found","errors":[{"message":"Failed to find a solution after 100 generations"}]}}}}}}},"/api/v1/scheduler/schedule/relaxed/{relaxation_level}":{"post":{"tags":["Schedule Generation"],"summary":"Generate schedule with constraint relaxation","description":"Generate a schedule with specific constraint relaxation level.\n    \n    This endpoint allows for generating schedules with relaxed constraints\n    when a fully constrained schedule is not feasible. You can specify\n    the exact relaxation level to apply.\n    \n    Available relaxation levels:\n    - minimal: Relax only soft constraints\n    - moderate: Relax soft constraints and some teacher preferences\n    - significant: Relax most constraints except required periods\n    - maximum: Relax all constraints except absolute requirements\n    \n    Use this endpoint when standard solvers fail to find a solution.","operationId":"create_schedule_relaxed_api_v1_scheduler_schedule_relaxed__relaxation_level__post","parameters":[{"name":"relaxation_level","in":"path","required":true,"schema":{"type":"string","title":"Relaxation Level"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ScheduleRequest"}}}},"responses":{"200":{"description":"Successful schedule generation with relaxation","content":{"application/json":{"schema":{"type":"object","title":"Response Create Schedule Relaxed Api V1 Scheduler Schedule Relaxed  Relaxation Level  Post"},"example":{"status":"success","message":"Schedule generated successfully with relaxed constraints","data":{"assignments":[{"name":"PK207","classId":"class-123","date":"2025-02-12T00:00:00Z","timeSlot":{"dayOfWeek":1,"period":1}}],"metadata":{"duration_ms":1200,"solutions_found":1,"score":-650000000,"solver":"cp-sat-unified","relaxation_level":"moderate","relaxation_status":{"relaxed_constraints":["consecutive_classes","preferred_periods"],"preserved_constraints":["required_periods","conflicts"]}}}}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Internal server error"},"400":{"description":"Bad request","content":{"application/json":{"example":{"status":"error","message":"Invalid relaxation level","errors":[{"message":"Relaxation level must be one of: minimal, moderate, significant, maximum"}]}}}}}}},"/api/v1/scheduler/compare":{"post":{"tags":["Schedule Generation"],"summary":"Compare results from different solvers","description":"Compare the results of different solvers for the same schedule request.\n    \n    This endpoint runs both the stable (CP-SAT) and development (genetic algorithm)\n    solvers on the same request and generates a detailed comparison of results,\n    including:\n    - Assignment differences\n    - Score differences\n    - Performance metrics\n    - Quality metrics\n    \n    This is useful for:\n    - Evaluating which solver works best for your specific use case\n    - Debugging scheduling issues\n    - Understanding tradeoffs between different solving approaches","operationId":"compare_solvers_api_v1_scheduler_compare_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ScheduleRequest"}}},"required":true},"responses":{"200":{"description":"Successful solver comparison","content":{"application/json":{"schema":{"type":"object","title":"Response Compare Solvers Api V1 Scheduler Compare Post"},"example":{"status":"success","message":"Solver comparison complete","data":{"stable":{"assignments":[{"truncated":"for brevity"}],"metadata":{"duration_ms":1500,"solutions_found":1,"score":-857960000,"solver":"cp-sat-stable"}},"development":{"assignments":[{"truncated":"for brevity"}],"metadata":{"duration_ms":3500,"solutions_found":1,"score":-750000000,"solver":"genetic-algorithm"}},"comparison":{"assignment_differences":5,"score_difference_pct":12.6,"speed_ratio":0.43,"recommendation":"stable"}}}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Internal server error"},"400":{"description":"Bad request","content":{"application/json":{"example":{"status":"error","message":"Failed to compare solvers","errors":[{"message":"One or both solvers failed to generate a valid schedule"}]}}}}}}},"/api/v1/scheduler/tune-weights":{"post":{"tags":["Schedule Generation"],"summary":"Tune solver weights for optimal results","description":"Tune the solver weights for a specific schedule request.\n    \n    This endpoint runs the weight tuning algorithm to find optimal\n    weights for the given schedule request. It performs a meta-optimization\n    process that:\n    1. Tries multiple weight configurations\n    2. Evaluates solution quality for each configuration\n    3. Searches for the best weights that maximize solution quality\n    \n    The tuning process uses a genetic algorithm to explore the\n    weight configuration space efficiently.\n    \n    You can specify the number of iterations to run using the 'iterations'\n    query parameter (1-20, default is 5).","operationId":"tune_weights_api_v1_scheduler_tune_weights_post","parameters":[{"name":"iterations","in":"query","required":false,"schema":{"type":"integer","maximum":20,"minimum":1,"default":5,"title":"Iterations"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ScheduleRequest"}}}},"responses":{"200":{"description":"Successful weight tuning","content":{"application/json":{"schema":{"type":"object","title":"Response Tune Weights Api V1 Scheduler Tune Weights Post"},"example":{"status":"success","message":"Weight tuning completed successfully","data":{"weights":{"final_week_compression":3500,"day_usage":2200,"daily_balance":1800,"preferred_periods":1200,"distribution":1500,"avoid_periods":-600,"earlier_dates":15},"metrics":{"iterations":5,"initial_score":-750000000,"tuned_score":-850000000,"improvement":"13.3%","duration_ms":12500},"sample_schedule":{"assignments":[{"truncated":"for brevity"}],"metadata":{"truncated":"for brevity"}}}}}}},"404":{"description":"Not found"},"422":{"description":"Validation error","content":{"application/json":{"example":{"status":"error","message":"Validation error","errors":[{"message":"iterations must be between 1 and 20","field":"iterations"}]}}}},"500":{"description":"Internal server error"},"400":{"description":"Bad request","content":{"application/json":{"example":{"status":"error","message":"Weight tuning failed","errors":[{"message":"Failed to find valid solutions during tuning process"}]}}}}}}},"/api/v1/scheduler/config":{"put":{"tags":["Schedule Generation"],"summary":"Update solver configuration","description":"Update the solver configuration with new weights.\n    \n    This endpoint allows updating the weights used by the solver for\n    constraint satisfaction. The weight configuration controls how\n    the solver prioritizes different aspects of the schedule quality.\n    \n    Weight parameters:\n    - final_week_compression: Higher values prefer utilizing the earlier weeks\n    - day_usage: Higher values prefer distributing classes across more days\n    - daily_balance: Higher values prefer balanced distribution across periods\n    - preferred_periods: Higher values prioritize teacher preferred periods\n    - distribution: Higher values emphasize balanced class distribution\n    - avoid_periods: More negative values increase penalty for avoided periods\n    - earlier_dates: Higher values prefer scheduling classes earlier","operationId":"update_solver_config_api_v1_scheduler_config_put","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WeightConfig"}}},"required":true},"responses":{"200":{"description":"Configuration successfully updated","content":{"application/json":{"schema":{"type":"object","title":"Response Update Solver Config Api V1 Scheduler Config Put"},"example":{"status":"success","message":"Solver configuration updated successfully","data":{"final_week_compression":3000,"day_usage":2000,"daily_balance":1500,"preferred_periods":1000,"distribution":1000,"avoid_periods":-500,"earlier_dates":10}}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Internal server error"},"400":{"description":"Bad request","content":{"application/json":{"example":{"status":"error","message":"Invalid configuration","errors":[{"message":"Weight values out of allowed range"}]}}}}}}},"/api/v1/scheduler/config/reset":{"post":{"tags":["Schedule Generation"],"summary":"Reset solver configuration to defaults","description":"Reset the solver configuration to defaults.\n    \n    This endpoint resets all solver parameters to their default values.\n    Default values are designed to work well for most scheduling scenarios\n    and provide a balanced approach to constraint satisfaction.\n    \n    Use this endpoint when you want to start fresh after experimenting\n    with custom weight configurations.","operationId":"reset_solver_config_api_v1_scheduler_config_reset_post","responses":{"200":{"description":"Configuration successfully reset","content":{"application/json":{"schema":{"type":"object","title":"Response Reset Solver Config Api V1 Scheduler Config Reset Post"},"example":{"status":"success","message":"Solver configuration reset to defaults","data":{"final_week_compression":3000,"day_usage":2000,"daily_balance":1500,"preferred_periods":1000,"distribution":1000,"avoid_periods":-500,"earlier_dates":10}}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Internal server error"}}}},"/api/v1/scheduler/metrics":{"get":{"tags":["Schedule Generation"],"summary":"Get solver performance metrics","description":"Get solver performance metrics.\n    \n    This endpoint returns metrics about solver performance and usage, including:\n    - Success/failure rates\n    - Average solution times\n    - Distribution quality statistics\n    - Constraint satisfaction metrics\n    - Usage patterns\n    \n    These metrics help monitor solver performance and identify potential\n    optimization opportunities.","operationId":"get_solver_metrics_api_v1_scheduler_metrics_get","responses":{"200":{"description":"Metrics retrieved successfully","content":{"application/json":{"schema":{"type":"object","title":"Response Get Solver Metrics Api V1 Scheduler Metrics Get"},"example":{"status":"success","message":"Solver metrics retrieved successfully","data":{"performance":{"avg_duration_ms":1850,"success_rate":0.95,"attempts":120,"failures":6},"distribution":{"avg_period_balance":0.85,"avg_day_balance":0.92},"constraints":{"relaxation_frequency":0.15,"preferred_periods_satisfaction":0.88},"usage":{"stable_solver_usage":95,"dev_solver_usage":25}}}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Internal server error","content":{"application/json":{"example":{"status":"error","message":"Failed to retrieve solver metrics","errors":[{"message":"Error accessing metrics database"}]}}}}}}},"/dashboard/analyze":{"post":{"tags":["Dashboard"],"summary":"Analyze schedule","description":"Analyze a schedule and generate dashboard data","operationId":"analyze_schedule_dashboard_analyze_post","parameters":[{"name":"solver_type","in":"query","required":false,"schema":{"type":"string","description":"Solver type (stable or dev)","default":"stable","title":"Solver Type"},"description":"Solver type (stable or dev)"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ScheduleRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DashboardData"}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Server error"}}}},"/dashboard/compare":{"post":{"tags":["Dashboard"],"summary":"Compare schedules","description":"Compare two schedules and return detailed comparison metrics","operationId":"compare_schedule_analysis_dashboard_compare_post","parameters":[{"name":"baseline_id","in":"query","required":true,"schema":{"type":"string","description":"ID of baseline schedule","title":"Baseline Id"},"description":"ID of baseline schedule"},{"name":"comparison_id","in":"query","required":true,"schema":{"type":"string","description":"ID of comparison schedule","title":"Comparison Id"},"description":"ID of comparison schedule"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ScheduleComparisonResult"},"title":"Response Compare Schedule Analysis Dashboard Compare Post"}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Server error"}}}},"/dashboard/history":{"get":{"tags":["Dashboard"],"summary":"Get schedule history","description":"Get list of previously analyzed schedules","operationId":"get_schedule_history_dashboard_history_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"items":{"type":"object"},"type":"array","title":"Response Get Schedule History Dashboard History Get"}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Server error"}}}},"/dashboard/metrics/{schedule_id}":{"get":{"tags":["Dashboard"],"summary":"Get schedule metrics","description":"Get quality metrics for a specific schedule","operationId":"get_schedule_metrics_dashboard_metrics__schedule_id__get","parameters":[{"name":"schedule_id","in":"path","required":true,"schema":{"type":"string","title":"Schedule Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ScheduleQualityMetrics"}}}},"404":{"description":"Not found"},"422":{"description":"Validation error"},"500":{"description":"Server error"}}}},"/dashboard/chart/{chart_type}/{schedule_id}":{"get":{"tags":["Dashboard"],"summary":"Get chart data","description":"Get specific chart data for a schedule","operationId":"get_chart_data_dashboard_chart__chart_type___schedule_id__get","parameters":[{"name":"chart_type","in":"path","required":true,"schema":{"type":"string","title":"Chart Type"}},{"name":"schedule_id","in":"path","required":true,"schema":{"type":"string","title":"Schedule Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChartData"}}}},"404":{"description":"Not found"},"422":{"description":"V